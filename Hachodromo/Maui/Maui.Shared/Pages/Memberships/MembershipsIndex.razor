@page "/memberships"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject INativeDialogService dialogService
@attribute [Authorize(Roles = "Admin")]

@if (memberships is null)
{
    <div class="spinner" />
}
else
{
    <GenericList MyList="memberships">
        <Body>
            <div class="card">
                <div class="card-header">
                    <span>
                        <i class="oi oi-list"></i> Membresías
                        <a class="btn btn-sm btn-primary float-end" @onclick=@(() => ShowModal())>
                            <i class="oi oi-plus"></i> Añadir Membresía
                        </a>
                    </span>
                </div>
                <div class="card-body">
                    <!-- Filtros responsivos -->
                    <div class="row g-2 align-items-center mb-3">
                        <div class="col-12 col-md-6 col-lg-4">
                            <input type="text" class="form-control" id="titulo"
                                   placeholder="Buscar Membresía..." @bind-value="Filter" />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-outline-primary w-100" @onclick="ApplyFilterAsync">
                                <i class="oi oi-layers" /> Filtrar
                            </button>
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-outline-danger w-100" @onclick="CleanFilterAsync">
                                <i class="oi oi-ban" /> Limpiar
                            </button>
                        </div>
                    </div>

                    <Pagination CurrentPage="currentPage"
                                TotalPages="totalPages"
                                SelectedPage="SelectedPageAsync" />

                    <!-- Tabla -->
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Membresía</th>
                                    <th>Descripción</th>
                                    <th>Precio</th>
                                    <th>Duración</th>
                                    <th>Descuento</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var membership in memberships)
                                {
                                    <tr>
                                        <td>@membership.Name</td>
                                        <td>@membership.Description</td>
                                        <td>@membership.Price.ToString("C")</td>
                                        <td>@($"{membership.Duration} meses")</td>
                                        <td>@membership.Discount.ToString("P")</td>
                                        <td>
                                            <div class="d-flex flex-column flex-sm-row flex-wrap gap-1">
                                                <button class="btn btn-sm btn-warning" @onclick="() => ShowModal(membership.Id, true)">
                                                    <i class="oi oi-pencil"></i> <span class="d-none d-sm-inline">Editar</span>
                                                </button>
                                                <button class="btn btn-sm btn-danger" @onclick="@(() => Delete(membership.Id))">
                                                    <i class="oi oi-trash"></i> <span class="d-none d-sm-inline">Borrar</span>
                                                </button>
                                                <button class="btn btn-sm btn-dark" @onclick="@(() => ManageMembership(membership.Id))">
                                                    <i class="oi oi-cog"></i> <span class="d-none d-sm-inline">Gestionar</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </Body>
    </GenericList>
}

@code {
    public List<Membership>? memberships { get; set; }
    private int currentPage = 1;
    private int totalPages;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    [CascadingParameter]
    IModalService Modal { get; set; } = default!;


    protected async override Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/memberships?page={page}";
            url2 = $"api/memberships/totalPages";
        }
        else
        {
            url1 = $"api/memberships?page={page}&filter={Filter}";
            url2 = $"api/memberships/totalPages?filter={Filter}";
        }

        try
        {
            var responseHppt = await repository.Get<List<Membership>>(url1);
            var responseHppt2 = await repository.Get<int>(url2);
            memberships = responseHppt.Response!;
            totalPages = responseHppt2.Response!;
        }
        catch (Exception ex)
        {
			var message = ex.Message;
            await dialogService.ShowAlertAsync("Error", message ?? "Ocurrió un error desconocido", "Aceptar");
        }
    }

    private async Task Delete(int membershipId)
    {
		var confirm = await dialogService.ShowConfirmMessageAsync("Eliminar Membresía", "¿Está seguro de que desea eliminar esta membresía?");

        if (!confirm)
        {
            return;
        }

        var responseHTTP = await repository.Delete($"api/memberships/{membershipId}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
				await dialogService.ShowAlertAsync("Error", mensajeError ?? "Ocurrió un error desconocido", "Aceptar");
            }
        }
        else
        {
			await dialogService.ShowToastAsync("Membresía eliminada", ToastType.Success);
            await LoadAsync();
        }
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
        await SelectedPageAsync(page);
    }

    private async Task ShowModal(int id = 0, bool isEdit = false)
    {
        IModalReference modalReference;
        if (isEdit)
        {
            modalReference = Modal.Show<MembershipEdit>($"Editar categoría", new ModalParameters().Add("MembershipId", id));
        }
        else
        {
            modalReference = Modal.Show<MembershipCreate>($"Crear categoría");
        }

        var result = await modalReference.Result;
        if (result.Confirmed)
        {
            await LoadAsync();
        }
    }

	private void ManageMembership(int membershipId)
	{
		navigationManager.NavigateTo($"/memberships/manage/{membershipId}/users");
	}
}
