@page "/reservations/admin"
@inject IRepository repository
@inject INativeDialogService dialogService
@using MudBlazor

<MudPaper Class="p-4">
    <MudText Typo="Typo.h5">Gestión de Reservas</MudText>

    <!-- Selector de sitio -->
    <MudSelect T="Site"
               Value="_selectedSite"
               ValueChanged="OnSiteChanged"
               ValueExpression="@(() => _selectedSite)"
               Label="Selecciona un sitio"
               Dense Class="mb-2">

        @foreach (var site in _sites)
        {
            <MudSelectItem Value="site">@site.Name</MudSelectItem>
        }
    </MudSelect>



    <!-- Botones conmutadores Vista -->
    <MudButtonGroup Color="Color.Primary" Class="my-2">
        <MudButton Variant="@GetVariant("Día")" OnClick="@(()=>ChangeView("Día"))">Día</MudButton>
        <MudButton Variant="@GetVariant("Semana")" OnClick="@(()=>ChangeView("Semana"))">Semana</MudButton>
        <MudButton Variant="@GetVariant("Mes")" OnClick="@(()=>ChangeView("Mes"))">Mes</MudButton>
    </MudButtonGroup>

    <!-- Selector de fecha -->
    <MudDatePicker T="DateTime" Value="_selectedDate" ValueChanged="HandleDateChanged"
                   Label="Selecciona fecha" PickerVariant="PickerVariant.Dialog" DisableToolbar="true"
                   MinDate="@DateTime.Today" Class="mb-4" Immediate="true" />

    <!-- Render de la vista -->
    @if (_selectedSite is not null)
    {
        @switch (_viewMode)
        {
            case "Día":
                <ReservationViewDay Site="_selectedSite" Date="_selectedDate" Reservations="_reservations" />
                break;
            case "Semana":
                <ReservationViewWeek Site="_selectedSite" Date="_selectedDate" Reservations="_reservations" />
                break;
            case "Mes":
                <ReservationViewMonth Site="_selectedSite" Date="_selectedDate" Reservations="_reservations" />
                break;
        }
    }
</MudPaper>

@code {
    private List<Site> _sites = new();
    private Site? _selectedSite;
    private DateTime _selectedDate = DateTime.Today;
    private string _viewMode = "Día";
    private List<ReservationDto> _reservations = new();

    private Variant GetVariant(string mode) => _viewMode == mode ? Variant.Filled : Variant.Outlined;

    private async Task OnSiteChanged(Site? newSite)
    {
        _selectedSite = newSite;
        if (_selectedSite is not null)
            await LoadReservationsForSite(_selectedSite.Id, _selectedDate);
    }

    private void ChangeView(string mode) => _viewMode = mode;
    protected override async Task OnInitializedAsync() => await LoadSites();

    private async Task LoadSites()
    {
        var r = await repository.Get<List<Site>>("/api/sites");
        if (r.Error)
        {
            await dialogService.ShowAlertAsync("Error", await r.GetErrorMessageAsync() ?? "Error desconocido", "Aceptar");
            return;
        }
        _sites = r.Response!;
    }

    private async Task HandleDateChanged(DateTime d)
    {
        _selectedDate = d;
        await LoadReservationsForSite(_selectedSite?.Id, _selectedDate);
        StateHasChanged();
    }

    private async Task LoadReservationsForSite(int? siteId, DateTime date)
    {
        if (!siteId.HasValue) return;
        var r = await repository.Get<List<ReservationDto>>($"/api/sites/{siteId}/reservations?date={date:yyyy-MM-dd}");
        if (r.Error)
        {
            await dialogService.ShowAlertAsync("Error", await r.GetErrorMessageAsync() ?? "Error desconocido", "Aceptar");
            return;
        }
        _reservations = r.Response ?? new();
    }
}